    {
      "parameters": {
        "jsCode": "// Looks up the ID of the Gmail label and marks mails that already carry it.\nconst LABEL = 'energiewacht-n8n';\nconst label = $input.all().find(l => l.json.name === LABEL);\nif (!label) {\n  throw new Error(`Gmail-label '${LABEL}' bestaat niet. Maak hem eerst aan in Gmail.`);\n}\nreturn $('Zoek Energiewacht mail').all().map(m => ({\n  json: {\n    id: m.json.id,\n    subject: m.json.Subject,\n    labelId: label.json.id,\n    alVerwerkt: (m.json.labels || []).some(l => l.id === label.json.id),\n  },\n}));\n"
      },
      "id": "7631b1e3-c31e-52ef-a602-750dc059465a",
      "name": "Label-ID erbij",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        100
      ]
    },
