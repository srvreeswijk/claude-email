      "id": "5000f217-cebe-5027-997e-1cea6afada7f",
      "name": "Claude: mail beoordelen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1760,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
