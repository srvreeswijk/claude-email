    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns Claude's verdict into the Dutch notification text.\nconst res = $json;\nif (res.stop_reason !== 'end_turn') {\n  throw new Error(`Claude stopte met stop_reason=${res.stop_reason}`);\n}\nconst d = JSON.parse(res.content.filter(b => b.type === 'text').map(b => b.text).join(''));\nconst subject = $('Label-ID erbij').item.json.subject;\n// Date the mail arrived, e.g. \"12 okt 2026, 14:03\", to tell mails with the same subject apart.\nconst mailDate = $('Mail ophalen').item.json.date;\nconst ontvangen = mailDate && new Date(mailDate).toLocaleString('nl-NL', {\n  timeZone: 'Europe/Amsterdam', dateStyle: 'medium', timeStyle: 'short',\n});\n\nconst kop = {\n  geen_actie: '✅ Energiewacht: geen betaalactie nodig.',\n  actie_nodig: '⚠️ Let op, actie nodig: Energiewacht vraagt je zelf te betalen.',\n  onduidelijk: '❓ Energiewacht: niet duidelijk of je moet betalen. Lees de mail zelf.',\n}[d.oordeel];\nconst details = [\n  d.bedrag && `Bedrag: ${d.bedrag}`,\n  d.uiterste_datum && `Betaaldatum: ${d.uiterste_datum}`,\n].filter(Boolean).join(' · ');\n\nconst onderwerp = `Onderwerp: ${subject}` + (ontvangen ? ` (ontvangen ${ontvangen})` : '');\nconst tekst = [kop, details, d.samenvatting, onderwerp].filter(Boolean).join('\\n');\nreturn { json: { tekst, oordeel: d.oordeel } };\n"
      },
