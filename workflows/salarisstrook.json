    {
      "id": "e6da4e04-058e-5667-9158-e15dd0a75959",
      "name": "Maskeren en prompt bouwen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Masks account and personnel numbers, then builds the Claude request.\n// Only the masked text leaves this machine.\nconst masked = $json.text\n  // IBAN, with or without spaces\n  .replace(/\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){3,7}(?: ?[A-Z0-9]{1,3})?\\b/g, '[IBAN]')\n  // Long bare digit runs: personnel number, BSN. Amounts always contain a comma.\n  .replace(/\\b\\d{6,12}\\b/g, '[NUMMER]');\n\nconst schema = {\n  type: 'object',\n  additionalProperties: false,\n  required: ['bruto', 'ikb', 'netto', 'herberekening', 'uitbetaald'],\n  properties: {\n    bruto: { anyOf: [{ type: 'number' }, { type: 'null' }] },\n    ikb: { anyOf: [{ type: 'number' }, { type: 'null' }] },\n    netto: { anyOf: [{ type: 'number' }, { type: 'null' }] },\n    herberekening: {\n      anyOf: [\n        { type: 'null' },\n        {\n          type: 'object',\n          additionalProperties: false,\n          required: ['posten', 'onderdelen'],\n          properties: {\n            posten: {\n              type: 'array',\n              items: {\n                type: 'object',\n                additionalProperties: false,\n                required: ['omschrijving', 'bedrag'],\n                properties: {\n                  omschrijving: { type: 'string' },\n                  bedrag: { type: 'number' },\n                },\n              },\n            },\n            onderdelen: {\n              type: 'array',\n              items: {\n                type: 'object',\n                additionalProperties: false,\n                required: ['categorie', 'bedrag'],\n                properties: {\n                  categorie: { type: 'string', enum: ['reiskosten', 'thuiswerk', 'ikb', 'overig'] },\n                  bedrag: { type: 'number' },\n                },\n              },\n            },\n          },\n        },\n      ],\n    },\n    uitbetaald: { anyOf: [{ type: 'number' }, { type: 'null' }] },\n  },\n};\n\nconst system = `You extract amounts from the text of a Dutch payslip (salarisstrook) issued by P-Direkt.\nThe text was extracted from a PDF, so columns can appear out of order.\nAmounts use Dutch notation: 6.545,34 means 6545.34. Return amounts as JSON numbers in euros.\nUse null for a field that is not on the payslip. Never estimate or compute a value that is not printed.\n\nFields:\n- bruto: the amount on the line \"Salaris\".\n- ikb: the amount on the line \"Betaling IKB\", or null.\n- netto: the amount on the line \"Netto maandelijks salaris\".\n- herberekening: null when the payslip has no recalculation (no lines marked with * that refer to\n  \"herberekening\", and no \"Herberekening\" appendix). Otherwise:\n  - posten: the lines on the first page that are marked with * as the result of a recalculation\n    (for example \"Herb.verschil incidenteel\" and \"Netto Herb.verschil\"). For each, the description\n    as printed and the amount as printed, negative when printed with a minus sign.\n  - onderdelen: the individual specification lines of the \"Herberekening\" appendix, without its\n    subtotal lines. For each, a categorie and the amount as printed, negative when printed with a\n    minus sign. Categories: \"reiskosten\" for commuting (woon-werk, reiskosten, also when paid via\n    IKB), \"thuiswerk\" for working from home, \"ikb\" for other IKB lines, \"overig\" for anything else.\n- uitbetaald: the amount on the line \"U ontvangt\".`;\n\nreturn {\n  json: {\n    claudeRequest: {\n      model: 'claude-opus-5',\n      max_tokens: 4000,\n      fallbacks: 'default',\n      output_config: {\n        effort: 'low',\n        format: { type: 'json_schema', schema },\n      },\n      system,\n      messages: [{ role: 'user', content: masked }],\n    },\n  },\n};\n"
      }
    },
    {
      "id": "287a4a2c-ce81-516b-930c-b839f2733e46",
      "name": "Claude: bedragen uitlezen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claudeRequest) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Header Auth account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "be89df78-1692-5021-8f36-5302acfc267b",
      "name": "Bericht opstellen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns Claude's JSON into the Dutch notification text.\nconst res = $json;\nif (res.stop_reason !== 'end_turn') {\n  throw new Error(`Claude stopte met stop_reason=${res.stop_reason}`);\n}\nconst d = JSON.parse(res.content.filter(b => b.type === 'text').map(b => b.text).join(''));\n\n// 6545.34 -> \"6.545,34\"\nconst nl = n => {\n  const [int, dec] = Math.abs(n).toFixed(2).split('.');\n  return int.replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.') + ',' + dec;\n};\nconst eur = n => (n < 0 ? '-' : '') + '€' + nl(n);\nconst signed = n => (n < 0 ? '-' : '+') + '€' + nl(n);\n\n// Cross-check: every amount Claude returned must literally appear in the PDF text.\nconst pdfText = $('PDF naar tekst').item.json.text;\nconst missing = [];\nconst check = (field, n) => {\n  if (n != null && !pdfText.includes(nl(n))) missing.push(field);\n};\ncheck('bruto', d.bruto);\ncheck('IKB', d.ikb);\ncheck('netto', d.netto);\n(d.herberekening?.posten || []).forEach(p => check(p.omschrijving, p.bedrag));\n(d.herberekening?.onderdelen || []).forEach(o => check(o.categorie, o.bedrag));\ncheck('uitbetaald', d.uitbetaald);\n\nconst parts = [];\nif (d.bruto != null) parts.push(`bruto ${eur(d.bruto)}` + (d.ikb != null ? ` + IKB ${eur(d.ikb)}` : ''));\nif (d.netto != null) parts.push(`netto ${eur(d.netto)}`);\nif (d.herberekening) {\n  // The payslip prints no total; it is the sum of the starred lines on page 1.\n  const totaal = d.herberekening.posten.reduce((sum, p) => sum + p.bedrag, 0);\n  const names = [...new Set(d.herberekening.onderdelen.map(o => o.categorie))].join(', ');\n  parts.push(`herberekening ${signed(totaal)}` + (names ? ` (${names})` : ''));\n}\nif (d.uitbetaald != null) parts.push(`uitbetaald ${eur(d.uitbetaald)}`);\n\nlet tekst = `${$('Label-ID erbij').item.json.subject}: ${parts.join(' · ')}`;\nif (missing.length) tekst += `\\n⚠ Niet letterlijk teruggevonden in de PDF: ${missing.join(', ')}. Controleer de strook.`;\n\nreturn { json: { tekst } };\n"
      }
    },
