# Settings for the deploy scripts. Copy to config.env (git ignores it) and fill in.
# No secrets here: the encryption key and the login password only live on the VPS.

# The VPS, prepared with the scripts in GPXDock/GPXDock.Web/deploy (same values as there)
VPS_HOST=203.0.113.10          # IP address (or hostname) of the VPS
VPS_SSH_PORT=22
VPS_USER=deploy                # user that GPXDock's 01_provision_vps.sh created

# n8n
N8N_HOST=n8n.example.nl        # hostname; its DNS A record must point to VPS_HOST
N8N_VERSION=2.41.6             # pinned image tag, see https://github.com/n8n-io/n8n/releases

# Optional: filled in for VUL-HIER-JE-TELEGRAM-CHAT-ID-IN by import_workflows.sh
TELEGRAM_CHAT_ID=
