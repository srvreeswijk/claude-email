# Copy to .env and fill in. .env is git-ignored.

# Pinned n8n image tag, e.g. 2.41.6 (check https://github.com/n8n-io/n8n/releases)
N8N_VERSION=2.41.6

# Random key that encrypts n8n's credential store. Generate once and keep it:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# The Gmail OAuth client, Anthropic API key and Telegram bot token are NOT set here.
# They are entered in n8n's credential store (Settings > Credentials) and stored
# encrypted in the n8n_data volume.
